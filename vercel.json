{
    "version": 2,
    "builds": [
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "app.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb"
            }
        },
        {
            "src": "static/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/$",
            "dest": "/index.html",
            "headers": {
                "cache-control": "public, max-age=0, s-maxage=300, stale-while-revalidate=600"
            }
        },
        {
            "src": "/static/(.*)",
            "dest": "/static/$1",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/_vercel/speed-insights/(.*)",
            "dest": "/_vercel/speed-insights/$1"
        },
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ],
    "crons": [
        {
            "path": "/api/import-step",
            "schedule": "0 7 * * *"
        },
        {
            "path": "/api/dream",
            "schedule": "0 9 * * *"
        }
    ]
}
