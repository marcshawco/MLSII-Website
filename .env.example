BUNNY_PULL_ZONE_URL=https://your-pullzone.b-cdn.net
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_ACCESS_KEY=your-access-key
M1_REFERRAL_URL=

# Shared AI memory MCP (Claude / Gemini / Grok / Muse)
CONTEXT_PASSWORD=choose-a-strong-password
CONTEXT_SESSION_SECRET=optional-separate-session-secret
CONTEXT_PUBLIC_URL=https://your-domain.com
# Injected by the Neon Marketplace integration (`vercel env pull` writes it to .env.local)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Vercel Cron sends this as a Bearer token to /api/dream
CRON_SECRET=generate-a-long-random-string
# AI Gateway. On Vercel, VERCEL_OIDC_TOKEN works automatically; set a key for local runs.
AI_GATEWAY_API_KEY=
# Optional overrides
# MEMORY_FAST_MODEL=anthropic/claude-haiku-5.5
# MEMORY_DREAM_MODEL=anthropic/claude-sonnet-5.5
# MEMORY_EMBED_MODEL=openai/text-embedding-3-small
# REASONING_FAKE=1   # offline stubs: no LLM calls, hash embeddings
